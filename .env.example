# ===== Application Configuration =====
APP_ENV=development
LOG_LEVEL=INFO

# ===== Vector Database (Qdrant) =====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nmk_chatbot_collection
QDRANT_TIMEOUT=30

# ===== Embedding Model =====
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# ===== LLM Configuration =====
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT=120
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL_NAME=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_FALLBACK_TIMEOUT=120

# ===== Retrieval Configuration =====
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.0
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4

# ===== Reranking Configuration =====
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_DEVICE=cpu
RERANKING_TOP_K=5
MIN_RELEVANCE_SCORE=3.0

# ===== Security =====
MAX_QUERY_LENGTH=500
RATE_LIMIT_PER_MINUTE=60

# ===== Authentication (JWT) =====
JWT_SECRET_KEY=change-me-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# ===== Database (users, chat history, documents) =====
DATABASE_URL=sqlite:///data/app.db

# ===== First admin account (auto-created on startup if not present) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
